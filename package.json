{
  "name": "hizway-rentals-cloudflare",
  "version": "1.1.0",
  "private": true,
  "description": "Rental and property management system for Hizway Investment Ltd, built on Cloudflare Workers and D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create hizway-rentals-db",
    "db:migrate:local": "wrangler d1 migrations apply hizway-rentals-db --local",
    "db:migrate": "wrangler d1 migrations apply hizway-rentals-db --remote",
    "check": "node --check src/index.js && node --check public/assets/app.js"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "wrangler": "^4.0.0" }
}
