{
  "name": "hizway-rentals",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hizway-rentals-db",
      "database_id": "a54a9631-89af-4266-8ee4-b56a64375909",
      "migrations_dir": "migrations"
    }
  ]
}
